# Local-only synthetic mode. Never commit a filled .env.
DEMO_SYNTHETIC=true
DATABASE_URL=postgresql+psycopg://civisar:civisar_local_only@localhost:5432/civisar
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# JSON object: username -> {password_hash: pbkdf2_sha256$iterations$salt_hex$hash_hex, role, area_scopes}
CIVISAR_DEMO_USERS_JSON={}
EARTHDATA_TOKEN=
FIRMS_MAP_KEY=
ACLED_TOKEN=
IOM_DTM_KEY=
# U-07 (doc 25): names only. Real values live in your local .env and the deploy secret store.
# Owners and expiry dates: docs/progress/KEYS.md
UCDP_ACCESS_TOKEN=
COPERNICUS_USER=
COPERNICUS_PASSWORD=
PUBLISHED_DIR=data/published
# A person must approve before the public map shows any data.
PUBLIC_RELEASE_APPROVED=false
# Reserved for a signed-session setup; the demo keeps sessions in memory and does not read it yet.
SESSION_SECRET=
