# Local-only synthetic mode. Never commit a filled .env.
DEMO_SYNTHETIC=true
DATABASE_URL=postgresql+psycopg://civisar:civisar_local_only@localhost:5432/civisar
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# JSON object: username -> {password_hash: pbkdf2_sha256$iterations$salt_hex$hash_hex, role, area_scopes}
CIVISAR_DEMO_USERS_JSON={}
EARTHDATA_TOKEN=
FIRMS_MAP_KEY=
ACLED_TOKEN=
IOM_DTM_KEY=
# Real-data mode reads private files from here (never commit them)
DATA_ROOT=data
# Host port for the Docker PostGIS (use 5433 if PostgreSQL already runs locally)
CIVISAR_DB_PORT=5432
# Worker (real-data mode): Thanoban's per-cell night-light history file, and fire release delay
NIGHTLIGHT_HISTORY=
FIRE_RELEASE_DELAY_HOURS=0
