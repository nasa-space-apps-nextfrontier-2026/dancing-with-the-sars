# Local-only synthetic mode. Never commit a filled .env.
DEMO_SYNTHETIC=true
DATABASE_URL=postgresql+psycopg://civisar:civisar_local_only@localhost:5432/civisar
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# JSON object: username -> {password_hash: pbkdf2_sha256$iterations$salt_hex$hash_hex, role, area_scopes}
CIVISAR_DEMO_USERS_JSON={}
EARTHDATA_TOKEN=
FIRMS_MAP_KEY=
ACLED_TOKEN=
IOM_DTM_KEY=
# Real-data mode reads private files from here (never commit them)
DATA_ROOT=data
# Host port for the Docker PostGIS (use 5433 if PostgreSQL already runs locally)
CIVISAR_DB_PORT=5432
# Worker (real-data mode): Thanoban's per-cell night-light history file, and fire release delay
NIGHTLIGHT_HISTORY=
FIRE_RELEASE_DELAY_HOURS=0
# U-07 (doc 25): names only. Real values live in your local .env and the deploy secret store.
# Owners and expiry dates: docs/progress/KEYS.md
UCDP_ACCESS_TOKEN=
COPERNICUS_USER=
COPERNICUS_PASSWORD=
# Where worker.main --publish/--agents write files; scripts.load_agent_outputs loads them into PostGIS.
PUBLISHED_DIR=data/published
# Not read: the public map is kept off (team decision, 15 Nov 2026). Kept for a future approved release.
PUBLIC_RELEASE_APPROVED=false
# Reserved for a signed-session setup; the demo keeps sessions in memory and does not read it yet.
SESSION_SECRET=
